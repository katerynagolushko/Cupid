{
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/handler?__path=:path*"
    }
  ],
  "functions": {
    "api/handler.mjs": {
      "maxDuration": 60,
      "includeFiles": "cache/**"
    }
  },
  "git": {
    "deploymentEnabled": false
  }
}
